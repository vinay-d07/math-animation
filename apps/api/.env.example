REDIS_URL=redis://localhost:6379
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# How many scene renders this process will run concurrently against E2B.
# Safe to raise well past the old local-CPU-bound default (was 2) since the
# actual compute now runs on E2B's infrastructure, not this process — just
# stay under your E2B plan's max concurrent sandboxes.
RENDER_CONCURRENCY=10
# How many scenes of one video project render concurrently.
SCENE_GENERATION_CONCURRENCY=3

# E2B sandbox — https://e2b.dev — every AI-generated Manim scene renders
# inside an isolated, network-less microVM built from sandbox-template/.
# Build it with: npx @e2b/cli@latest template create manim-render \
#   --dockerfile e2b.Dockerfile --cpu-count 1 --memory-mb 2048
# (run from the sandbox-template/ directory)
E2B_API_KEY=e2b_xxx
E2B_TEMPLATE_ID=manim-render

DATABASE_URL=mongodb+srv://<user>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority

CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

GROQ_API_KEY=gsk_xxx
GROQ_MODEL=openai/gpt-oss-120b
# Narration TTS voice (canopylabs/orpheus-v1-english on the same Groq key —
# accept that model's terms once at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english)
GROQ_TTS_VOICE=troy

# Optional — a free key from https://cloud.cerebras.ai routes storyboard
# planning to Cerebras instead of Groq, so it stops competing with scene
# codegen for Groq's rate limit. Leave unset to just use Groq everywhere.
# CEREBRAS_API_KEY=csk_xxx
# CEREBRAS_MODEL=gpt-oss-120b

# Supabase Storage — holds rendered clips (bucket must be created + set public, or served via signed URLs)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=renders
